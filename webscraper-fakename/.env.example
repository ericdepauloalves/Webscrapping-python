# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com suas credenciais reais) para o GitHub.

# Configuração do servidor SMTP
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# e SMTP_PASSWORD deve ser uma "senha de app" (não a senha normal da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui

# Email que aparecerá como remetente (geralmente igual ao SMTP_USER)
EMAIL_FROM=seuemail@gmail.com

# Email que vai RECEBER o CSV
EMAIL_TO=destinatario@example.com
